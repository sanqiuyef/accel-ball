#include "resource.h"

IDI_APPICON ICON "app.ico"
1 24 "app-dev.manifest"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "sanqiuyef"
      VALUE "FileDescription", "AccelBall development build"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "AccelBall"
      VALUE "OriginalFilename", "AccelBall-dev.exe"
      VALUE "ProductName", "AccelBall"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
